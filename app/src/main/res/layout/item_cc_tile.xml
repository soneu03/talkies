<?xml version="1.0" encoding="utf-8"?>
<!-- One Control Center tile: four across the top of the sheet, each a thing you reach for while watching.
     The sheet gives them 624 dp, so 150 apiece and 130 of that for words. The height is the icon, two lines of
     Spanish name ("Temporizador de apagado") and its state, so the state is not cut off at the bottom.
     Colours come from the theme in code, as everywhere else. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="96dp"
    android:layout_weight="1"
    android:gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/cc_glyph"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginBottom="4dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/input_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/plus_jakarta_sans"
        android:maxLines="2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/input_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_tight"
        android:singleLine="true"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
