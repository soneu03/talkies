<?xml version="1.0" encoding="utf-8"?>
<!-- One Control Center cell: two of these across the sheet, for the facts about the TV whose status is short.
     Half the sheet's width, so both lines give up their tail rather than their head: 283 dp of words in the right
     one (298 in the left, which carries no rule) against the widest pair there is - "Salida de sonido" and its
     "Barra de sonido", 252 dp together.
     The rule is the line between the two columns, shown only on the right one - without it, one column's figure and
     the next column's name read as one phrase. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="44dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <View
        android:id="@+id/cell_rule"
        android:layout_width="1dp"
        android:layout_height="22dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/input_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_tight"
        android:singleLine="true"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/input_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/inter_tight"
        android:maxWidth="140dp"
        android:singleLine="true"
        android:textAlignment="viewEnd"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
